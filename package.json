{
  "name": "tablefolk",
  "private": true,
  "scripts": {
    "dev": "node scripts/prepare-web.mjs && next dev",
    "build": "node build.mjs && node scripts/prepare-web.mjs && next build",
    "build:offline": "node build.mjs",
    "prepare:web": "node scripts/prepare-web.mjs",
    "typecheck": "node scripts/prepare-web.mjs && tsc --noEmit",
    "test": "node tests/verify.cjs",
    "test:cards": "node tests/card-guides.cjs",
    "test:mobile": "node tests/mobile-header.cjs",
    "test:chess": "node tests/chess-clock.cjs",
    "test:coup": "node tests/coup-session.cjs",
    "test:poker": "node tests/poker-timer.cjs",
    "test:skull": "node tests/skull-score.cjs",
    "test:moth": "node tests/moth-score.cjs",
    "test:scoreboard-ux": "node tests/scoreboard-ux.cjs",
    "test:truco": "node tests/truco-score.cjs",
    "test:flows": "node tests/game-flows.cjs",
    "serve": "node scripts/serve-export.mjs",
    "test:web": "node tests/next-app.cjs"
  },
  "devDependencies": {
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "playwright": "1.62.1",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1"
  },
  "engines": {
    "node": ">=20.9.0"
  }
